{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "stormwater.api.main:app",
        "--reload",
        "--app-dir",
        "backend/src",
        "--port",
        "8101"
      ],
      "port": 8101
    },
    {
      "name": "frontend-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_PROXY=http://127.0.0.1:8101",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "api-win",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "stormwater.api.main:app",
        "--app-dir",
        "backend/src",
        "--port",
        "8101"
      ],
      "port": 8101
    }
  ]
}