# 管网数据库（阿布扎比）—— 内网地址，仅公司网络可达
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除
PIPE_DB_HOST=10.255.254.109
PIPE_DB_PORT=35433
PIPE_DB_NAME=syq-pipe
PIPE_DB_SCHEMA=dmt_irrigationstormwater_abudhabi
PIPE_DB_USER=postgres
PIPE_DB_PASSWORD=

# 若通过 SSH 隧道访问，把 HOST/PORT 改为本地转发端口，例如：
# PIPE_DB_HOST=127.0.0.1
# PIPE_DB_PORT=15443

# 允许跨源访问 API 的前端地址（前后端分离）。逗号分隔，不填即用默认值
# http://localhost:5173,http://127.0.0.1:5173（Vite 开发服务器）。
# 前端走 Vite 代理时请求是同源的，不经过 CORS；只有直连后端才需要这里放行。
# CORS_ORIGINS=https://flood.example.com

# 仿真进度后台模拟（算力侧未接入前用）：1 开 / 0 关；单任务 0→100% 的分钟数；节拍秒数。
# 接上真实算力侧（PATCH /api/simulations/{id}/status 回写）后务必设为 0。
# SIM_MOCK_PROGRESS=1
# SIM_MOCK_RUN_MINUTES=10
# SIM_MOCK_TICK_SECONDS=5
